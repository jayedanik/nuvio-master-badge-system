{
  "version": "4.0.0-LOCKED",
  "system_name": "Nuvio Master Badge Design System & Theme Engine",
  "invariants": {
    "canvas_height_px": 96,
    "render_supersampling_scale": 4,
    "supersampling_height_px": 384,
    "output_format": "WEBP",
    "webp_quality": 95,
    "alpha_channel": "100% transparent (#00000000) with zero black boxes, smoked capsules, or artificial card borders",
    "min_horizontal_padding_px": 18,
    "manifest_standards": {
      "tagStyle": "filled",
      "tagColor": "#00000000",
      "borderColor": "#00000000",
      "textColor": "#FFFFFF"
    },
    "locked_previews": [
      "previews/theme-ecosystem.jpg",
      "previews/preview-washi-tape.jpg"
    ]
  },
  "themes": {
    "pristine": {
      "name": "Pristine Master",
      "dir": "badges",
      "json": "badges.json",
      "typography": {
        "primary": "arialbd.ttf",
        "secondary": "segoeui.ttf",
        "style": "Clean OLED Floating Vector Sans"
      }
    },
    "studio-markers": {
